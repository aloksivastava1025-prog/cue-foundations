{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cue-kit",
  "compatibility_date": "2026-11-01",
  // Kit is a static export (next build -> out/). There is no Worker script:
  // Cloudflare serves the files straight from Workers static assets, which
  // costs no CPU and isn't billed per request on the Free plan.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
